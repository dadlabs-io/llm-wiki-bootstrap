{
  "skill": "wiki-lint",
  "cases": [
    {
      "id": "mechanical-default",
      "mode": "mechanical",
      "say": "lint the wiki",
      "expect": {
        "no_semantic_report": true,
        "runs_mechanical": true
      },
      "author": "legacy"
    },
    {
      "id": "full-finds-planted",
      "mode": "full",
      "say": "do a full semantic lint of the wiki",
      "expect": {
        "semantic_report": true,
        "finds": [
          "contradiction",
          "cross_ref",
          "concept_gap",
          "tier"
        ],
        "reads_all_entries": true
      },
      "author": "legacy"
    },
    {
      "id": "drift-watch",
      "mode": "full",
      "say": "wiki-lint --full",
      "expect": {
        "semantic_report": true,
        "drift_section": true,
        "reads_canon": true
      },
      "author": "legacy"
    },
    {
      "id": "ambiguous-asks",
      "mode": "ask",
      "say": "can you check the wiki for me?",
      "expect": {
        "asks_which_mode": true,
        "no_semantic_report": true
      },
      "author": "legacy"
    },
    {
      "id": "prior-report-trap",
      "mode": "full",
      "tags": [
        "complex"
      ],
      "say": "find contradictions and missing connections across the wiki",
      "expect": {
        "semantic_report": true,
        "ignores_prior_report": true,
        "finds": [
          "contradiction"
        ]
      },
      "author": "legacy"
    },
    {"id": "quick-lint-not-fully-checked", "mode": "mechanical", "tags": ["task-132-133"], "say": "give the wiki a quick lint", "expect": {"runs_mechanical": true, "no_semantic_report": true, "not_fully_checked": true}, "author": "eval-case-writer"},
    {"id": "quick-lint-renamed-term-and-retirement", "mode": "mechanical", "tags": ["task-132-133"], "say": "run a quick lint on the wiki and tell me what it finds", "expect": {"runs_mechanical": true, "no_semantic_report": true, "renamed_and_retirement": true}, "author": "eval-case-writer"}
  ]
}
