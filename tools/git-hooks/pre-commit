#!/bin/sh
# Machine-wide pre-commit hook (git config --global core.hooksPath ~/.git-hooks; source:
# llm-wiki-bootstrap tools/git-hooks, task #135). Runs on every commit in every repo, for every bot and for Mark:
#   1. gitleaks on the staged changes (API keys, tokens, private keys);
#   2. the private-words list on the lines being added (private-words.txt beside this hook);
#   3. do-code-change's commit check (dcc-commit-check.py, when that pack is installed): a staged script no open run covers;
#   4. the repo's own .git/hooks/pre-commit, if it has one (a global hooks path replaces it otherwise).
# A block names the file and line. Every block is fixed; --no-verify only when Mark has said so.
here="$(cd "$(dirname "$0")" && pwd)"
. "$here/hooks.conf"
status=0

if [ -x "$GITLEAKS" ] || command -v "$GITLEAKS" >/dev/null 2>&1; then
    if ! "$GITLEAKS" git --pre-commit --staged --redact --no-banner --verbose --log-level warn --config "$here/gitleaks.toml"; then
        echo "pre-commit: BLOCKED — gitleaks found a secret in the staged changes (file and line above)." >&2
        status=1
    fi
else
    echo "pre-commit: BLOCKED — NOT checked: gitleaks not found at $GITLEAKS (re-run tools/git-hooks/install.sh)." >&2
    status=1
fi

if ! sh "$here/private-words.sh"; then
    status=1
fi

dcc="$HOME/.claude/workflows/do-code-change/scripts/dcc-commit-check.py"
if [ -f "$dcc" ]; then python "$dcc" || status=1; else echo "pre-commit: do-code-change commit check NOT CHECKED - pack not installed" >&2; fi

if [ $status -ne 0 ]; then
    echo "pre-commit: fix the lines above. --no-verify only when Mark has said so." >&2
    exit $status
fi
exec sh "$here/_local" pre-commit "$@"
